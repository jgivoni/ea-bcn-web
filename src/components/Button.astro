---
// The one button of the site. Its style is in src/styles/components.css, because Markdown content uses the same class.
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
}

const { href, variant = 'primary' } = Astro.props;
---

<a class:list={['button', variant === 'secondary' && 'secondary']} href={href}><slot /></a>
