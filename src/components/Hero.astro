---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt?: string;
}

const { image, alt = '' } = Astro.props;
---

<div class="hero">
  <Image class="hero-image" src={image} alt={alt} widths={[640, 1024, 1584]} sizes="100vw" loading="eager" />
</div>

<style>
  .hero {
    width: 100%;
    background: var(--color-bg-alt);
  }

  .hero-image {
    display: block;
    width: 100%;
    max-height: 26rem;
    min-height: 9rem;
    object-fit: cover;
    object-position: center;
  }
</style>
