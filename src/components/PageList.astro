---
// A list of pages as cards, composed from CardGrid and Card.
import { headingOf, loadPages, thumbnailOf, type Page } from '../lib/pages';
import Card from './Card.astro';
import CardGrid from './CardGrid.astro';

interface Props {
  items: Page[];
}

const { items } = Astro.props;
const pages = await loadPages();
---

<!-- The listed pages are indexed on their own, so the list is left out of search. -->
<div data-pagefind-ignore="all">
  <CardGrid columns="auto">
    {items.map((item) => <Card title={headingOf(item)} href={item.url} image={thumbnailOf(pages, item)} />)}
  </CardGrid>
</div>
