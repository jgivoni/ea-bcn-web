---
// A band of the page: side margins, vertical space, and the content width (centred).
---

<section class="section">
  <div class="inner">
    <slot />
  </div>
</section>

<style>
  .section {
    padding: clamp(var(--space-6), 4vw, 3.5rem) var(--gutter);
  }

  /* Two sections in a row share one gap instead of two. */
  .section + .section {
    padding-top: 0;
  }

  .inner {
    max-width: var(--width-content);
    margin: 0 auto;
  }
</style>
