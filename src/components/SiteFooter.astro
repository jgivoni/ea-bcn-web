---
// Icon paths: LinkedIn and YouTube from Simple Icons (CC0). Luma is its four-point star, drawn here.
const links = [
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/company/effective-altruism-barcelona',
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
  {
    label: 'Luma',
    href: 'https://lu.ma/calendar/cal-9tdD2nUvxmygpXa',
    path: 'M12 0C12.6 6.6 17.4 11.4 24 12 17.4 12.6 12.6 17.4 12 24 11.4 17.4 6.6 12.6 0 12 6.6 11.4 11.4 6.6 12 0z',
  },
  {
    label: 'YouTube',
    href: 'https://www.youtube.com/@eabarcelona',
    path: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
  },
];
---

<footer class="site-footer">
  <div class="inner">
    <p>
      <slot />{' '}
      <a href="mailto:effectivealtruismbarcelona@gmail.com">effectivealtruismbarcelona@gmail.com</a>
    </p>
    <ul>
      {
        links.map((link) => (
          <li>
            <a class="social" href={link.href} rel="noopener" aria-label={link.label} title={link.label}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={link.path} />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-7) var(--gutter);
    background: var(--color-footer-bg);
    color: var(--color-footer-text);
    font-size: var(--text-sm);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    max-width: var(--width-content);
    margin: 0 auto;
  }

  p {
    margin: 0;
  }

  a {
    color: inherit;
  }

  ul {
    display: flex;
    gap: var(--space-2);
    margin: 0 calc(-1 * var(--space-2));
    padding: 0;
    list-style: none;
  }

  /* 44px touch target around a 22px icon. */
  .social {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-sm);
    transition: color 0.15s;
  }

  .social:hover {
    color: light-dark(#7fd3e0, var(--color-primary));
  }

  svg {
    width: 1.375rem;
    height: 1.375rem;
    fill: currentColor;
  }
</style>
