---
import { LANG_LABELS, LANG_NAMES, type Lang } from '../lib/pages';
import { UI } from '../lib/ui';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

interface NavItem {
  label: string;
  href: string;
  current: boolean;
}

interface Props {
  lang: Lang;
  homeHref: string;
  nav: NavItem[];
  switcher: { lang: Lang; href: string }[];
}

const { lang, homeHref, nav, switcher } = Astro.props;
const ui = UI[lang];
---

<header class="site-header">
  <div class="bar">
    <Logo href={homeHref} />
    <input class="menu-toggle" type="checkbox" id="menu-toggle" aria-label={ui.menu} />
    <label class="menu-button" for="menu-toggle" aria-hidden="true">
      <span></span>
    </label>
    <div class="menu">
      <nav class="main-nav" aria-label={ui.mainNav}>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="tools">
        <nav class="languages" aria-label={ui.language}>
          {
            switcher.map((item) => (
              <a
                href={item.href}
                hreflang={item.lang}
                lang={item.lang}
                title={LANG_NAMES[item.lang]}
                aria-current={item.lang === lang ? 'true' : undefined}
              >
                {LANG_LABELS[item.lang]}
              </a>
            ))
          }
        </nav>
        <ThemeToggle lang={lang} />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-3);
    min-height: var(--header-height);
    padding: 0 var(--gutter-header);
  }

  .menu-toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .menu-button {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: calc(-1 * var(--space-2));
    cursor: pointer;
  }

  .menu-button span,
  .menu-button span::before,
  .menu-button span::after {
    display: block;
    width: 1.5rem;
    height: 2px;
    background: var(--color-text);
    content: '';
  }

  .menu-button span {
    position: relative;
  }

  .menu-button span::before {
    position: absolute;
    top: -7px;
  }

  .menu-button span::after {
    position: absolute;
    top: 7px;
  }

  .menu-toggle:focus-visible + .menu-button {
    outline: 3px solid var(--color-focus);
    border-radius: var(--radius-sm);
  }

  /* Phones and tablets: the menu opens below the bar. */
  .menu {
    display: none;
    flex-basis: 100%;
    padding: var(--space-2) 0 var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .menu-toggle:checked ~ .menu {
    display: block;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .main-nav a {
    display: block;
    padding: var(--space-3) 0;
    color: var(--color-text);
    text-decoration: none;
  }

  .main-nav a:hover,
  .main-nav a[aria-current='page'] {
    color: var(--color-primary-strong);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-3);
  }

  .languages {
    display: flex;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .languages a {
    padding: var(--space-2);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .languages a:hover {
    color: var(--color-primary-strong);
  }

  .languages a[aria-current] {
    color: var(--color-primary-strong);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  /* Wide screens: everything in one row. The breakpoint leaves room for the longest (Catalan) labels. */
  @media (min-width: 75rem) {
    .menu-button {
      display: none;
    }

    .menu,
    .menu-toggle:checked ~ .menu {
      display: flex;
      flex: 1;
      flex-basis: auto;
      align-items: center;
      justify-content: flex-end;
      gap: var(--space-5);
      padding: 0;
      border-top: 0;
    }

    ul {
      display: flex;
      gap: var(--space-5);
    }

    .main-nav a {
      padding: var(--space-2) 0;
      white-space: nowrap;
    }

    .main-nav a[aria-current='page'] {
      box-shadow: inset 0 -3px 0 var(--color-primary);
    }

    .tools {
      flex-wrap: nowrap;
      gap: var(--space-3);
      margin-top: 0;
    }

    .tools :global(.theme-toggle .label) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
