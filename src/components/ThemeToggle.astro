---
import type { Lang } from '../lib/pages';
import { UI } from '../lib/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = UI[lang];
---

<button class="theme-toggle" type="button" data-labels={JSON.stringify(ui.themes)} data-prefix={ui.theme}>
  <svg class="icon icon-light" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <svg class="icon icon-dark" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
  </svg>
  <svg class="icon icon-auto" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="8"></circle>
    <path d="M12 4a8 8 0 0 1 0 16z" class="fill"></path>
  </svg>
  <span class="label">{ui.themes.light}</span>
</button>

<script>
  const ORDER = ['light', 'dark', 'auto'] as const;
  type Theme = (typeof ORDER)[number];

  function current(): Theme {
    const value = document.documentElement.dataset.theme;
    return ORDER.includes(value as Theme) ? (value as Theme) : 'light';
  }

  function render(button: HTMLButtonElement) {
    const labels = JSON.parse(button.dataset.labels ?? '{}') as Record<Theme, string>;
    const theme = current();
    const label = button.querySelector('.label');
    if (label) label.textContent = labels[theme];
    button.setAttribute('aria-label', `${button.dataset.prefix}: ${labels[theme]}`);
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
    render(button);
    button.addEventListener('click', () => {
      const next = ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length];
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage can be blocked. The choice then lasts for this page only.
      }
      render(button);
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-xs);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-strong);
  }

  .icon {
    display: none;
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .icon .fill {
    fill: currentColor;
    stroke: none;
  }

  :global(:root:not([data-theme='dark']):not([data-theme='auto'])) .icon-light,
  :global(:root[data-theme='dark']) .icon-dark,
  :global(:root[data-theme='auto']) .icon-auto {
    display: block;
  }
</style>
