---
import Hero from '../components/Hero.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import {
  alternatesFor,
  describe,
  findByKey,
  HOME_SLUGS,
  LANGS,
  loadPages,
  OG_LOCALES,
  translatedUrl,
  urlFor,
  type Lang,
  type Page,
} from '../lib/pages';
import { photo } from '../lib/photos';
import { UI } from '../lib/ui';
import '../styles/global.css';

/** A content page passes `page`. A page outside the content collection (such as 404) passes `lang` and `title`. */
type Props = { page: Page } | { page?: undefined; lang: Lang; title: string };

const props = Astro.props;
const page = props.page;
const lang: Lang = page ? page.lang : props.lang!;
const site = Astro.site!.origin;
const pages = await loadPages();
const alternates: Partial<Record<Lang, string>> = page ? alternatesFor(pages, page) : {};
const description = page ? describe(page) : undefined;
const ui = UI[lang];
const isHome = page?.path === HOME_SLUGS[lang];
const pageTitle = page ? page.entry.data.title : props.title!;
const title = isHome ? `${ui.siteName} — ${pageTitle}` : `${pageTitle} | ${ui.siteName}`;
const absolute = (url: string) => site + (url === '/' ? '/' : url);
const canonical = page ? absolute(page.url) : undefined;

const navKeys = ['about', 'upcoming-events', 'past-events', 'take-action', 'get-involved'];
const isCurrent = (url: string) => !!page && (page.url === url || page.url.startsWith(`${url}/`));
const nav = navKeys
  .map((key) => findByKey(pages, lang, key))
  .filter((item): item is Page => Boolean(item))
  .map((item) => ({ label: item.entry.data.title, href: item.url, current: isCurrent(item.url) }));

const switcher = LANGS.map((other) => ({
  lang: other,
  href: translatedUrl(pages, page, other),
}));
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Runs before first paint so the page never shows the wrong theme. Light is the default.
      try {
        const saved = localStorage.getItem('theme');
        document.documentElement.dataset.theme = saved === 'dark' || saved === 'auto' ? saved : 'light';
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
    <title>{title}</title>
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {description && <meta name="description" content={description} />}
    {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    {Object.entries(alternates).map(([lang, url]) => <link rel="alternate" hreflang={lang} href={absolute(url)} />)}
    {
      alternates.en && Object.keys(alternates).length > 1 && (
        <link rel="alternate" hreflang="x-default" href={absolute(alternates.en)} />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={ui.siteName} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip" href="#content">{ui.skip}</a>
    <SiteHeader lang={lang} homeHref={urlFor(lang, HOME_SLUGS[lang])} nav={nav} switcher={switcher} />
    <!-- Only content pages are in the search index (data-pagefind-body). -->
    <main id="content" data-pagefind-body={page ? '' : undefined}>
      <Hero image={photo('hero')} alt="Park Güell, Barcelona" />
      <slot />
    </main>
    <SiteFooter>{ui.footerContact}</SiteFooter>
  </body>
</html>
