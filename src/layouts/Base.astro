---
import {
  alternatesFor,
  describe,
  findByKey,
  HOME_SLUGS,
  LANG_LABELS,
  LANG_NAMES,
  LANGS,
  loadPages,
  OG_LOCALES,
  urlFor,
  type Page,
} from '../lib/pages';
import '../styles/global.css';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const site = Astro.site!.origin;
const pages = await loadPages();
const alternates = alternatesFor(pages, page);
const description = describe(page);
const isHome = page.path === HOME_SLUGS[page.lang];
const title = isHome ? `EA Barcelona — ${page.entry.data.title}` : `${page.entry.data.title} | EA Barcelona`;
const canonical = site + (page.url === '/' ? '/' : page.url);

const navKeys = ['about', 'upcoming-events', 'past-events', 'take-action', 'get-involved'];
const nav = navKeys
  .map((key) => findByKey(pages, page.lang, key))
  .filter((item): item is Page => Boolean(item));
const home = urlFor(page.lang, HOME_SLUGS[page.lang]);

const switcher = LANGS.map((lang) => ({
  lang,
  url: alternates[lang] ?? urlFor(lang, HOME_SLUGS[lang]),
  exact: Boolean(alternates[lang]),
}));
const isActive = (url: string) => page.url === url || (url !== '/' && page.url.startsWith(`${url}/`));
---

<!doctype html>
<html lang={page.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      Object.entries(alternates).map(([lang, url]) => (
        <link rel="alternate" hreflang={lang} href={site + (url === '/' ? '/' : url)} />
      ))
    }
    {
      alternates.en && Object.keys(alternates).length > 1 && (
        <link rel="alternate" hreflang="x-default" href={site + (alternates.en === '/' ? '/' : alternates.en)} />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EA Barcelona" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALES[page.lang]} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={home}>EA Barcelona</a>
      <nav aria-label="Main">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.url} aria-current={isActive(item.url) ? 'page' : undefined}>
                  {item.entry.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav class="languages" aria-label="Language">
        {
          switcher.map((item) => (
            <a
              href={item.url}
              hreflang={item.lang}
              lang={item.lang}
              title={LANG_NAMES[item.lang]}
              aria-current={item.lang === page.lang ? 'true' : undefined}
            >
              {LANG_LABELS[item.lang]}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        EA Barcelona ·
        <a href="mailto:effectivealtruismbarcelona@gmail.com">effectivealtruismbarcelona@gmail.com</a>
      </p>
    </footer>
  </body>
</html>
