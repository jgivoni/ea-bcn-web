---
// Every content page: one Section with the page's Markdown in Prose, plus the parts its layout adds.
// All layouts compose the same components; none has styles of its own.
import { render } from 'astro:content';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import CardGrid from '../components/CardGrid.astro';
import PageList from '../components/PageList.astro';
import Prose from '../components/Prose.astro';
import RecapNav from '../components/RecapNav.astro';
import Section from '../components/Section.astro';
import Base from '../layouts/Base.astro';
import { childrenOf, loadPages, parentOf } from '../lib/pages';
import { photo } from '../lib/photos';

export async function getStaticPaths() {
  const pages = await loadPages();
  return pages.map((page) => ({
    params: { slug: page.url === '/' ? undefined : page.url.slice(1) },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page.entry);
const { layout, headline, cards = [], cta } = page.entry.data;
const pages = await loadPages();
const children = layout === 'index' ? childrenOf(pages, page) : [];
const isRecap = parentOf(pages, page)?.entry.data.layout === 'index';
---

<Base page={page}>
  <Section>
    <Prose>
      {layout === 'home' && <h1>{headline}</h1>}
      <Content />
    </Prose>
    {
      layout === 'home' && (
        <CardGrid>
          {cards.map((card) => (
            <Card title={card.title} href={card.href} image={photo(card.image)}>
              {card.text}
            </Card>
          ))}
        </CardGrid>
      )
    }
    {
      layout === 'home' && cta && (
        <Prose>
          <p>
            <Button href={cta.href}>{cta.label}</Button>
          </p>
        </Prose>
      )
    }
    {layout === 'index' && <PageList items={children} />}
    {isRecap && <RecapNav page={page} />}
  </Section>
</Base>
